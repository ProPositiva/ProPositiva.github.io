<title>Pulse — Know Your Financial Health</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@300;400;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin:0;padding:0;box-sizing:border-box; }
:root {
  --gold:#FFC000;
  --dark:#1C1C1C;
  --darker:#07080f;
  --navy:#0a0f2e;
  --white:#F5F0E8;
  --white-dim:rgba(245,240,232,0.45);
  --white-faint:rgba(245,240,232,0.07);
}
html { scroll-behavior:auto; }
body {
  background:var(--darker);
  color:var(--white);
  font-family:'JetBrains Mono',monospace;
  overflow-x:hidden;
  cursor:none;
}

/* CURSOR */
#cur { position:fixed;width:8px;height:8px;background:var(--gold);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:difference; }
#cur-ring { position:fixed;width:36px;height:36px;border:1px solid rgba(255,192,0,0.5);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%); }

/* CANVASES */
#bg-canvas { position:fixed;top:0;left:0;width:100%;height:100%;z-index:0; }
#main-canvas { position:fixed;top:0;left:0;width:100%;height:100%;z-index:1;pointer-events:none; }
#wave-canvas { position:fixed;bottom:0;left:0;width:100%;height:200px;z-index:3;pointer-events:none;opacity:0;transition:opacity 1s; }
#explode-canvas { position:fixed;top:0;left:0;width:100%;height:100%;z-index:6;pointer-events:none; }

/* GRAIN */
#grain {
  position:fixed;top:0;left:0;width:100%;height:100%;z-index:4;pointer-events:none;opacity:0.03;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size:256px;
  animation:grainAnim .4s steps(2) infinite;
}
@keyframes grainAnim { 0%{transform:translate(0,0)} 25%{transform:translate(-3px,2px)} 50%{transform:translate(2px,-2px)} 75%{transform:translate(-2px,3px)} 100%{transform:translate(3px,-3px)} }

/* VIGNETTE */
#vignette {
  position:fixed;top:0;left:0;width:100%;height:100%;z-index:2;pointer-events:none;
  background:radial-gradient(ellipse at center, transparent 40%, rgba(7,8,15,0.85) 100%);
}

/* PROGRESS */
#prog { position:fixed;top:0;left:0;height:2px;background:var(--gold);z-index:500;box-shadow:0 0 14px var(--gold),0 0 35px rgba(255,192,0,0.25);transition:width .08s; }

/* NAV */
nav {
  position:fixed;top:0;left:0;right:0;z-index:400;
  display:flex;justify-content:space-between;align-items:center;
  padding:1.8rem 3rem;
  transition:backdrop-filter .5s,background .5s,border-color .5s;
  border-bottom:1px solid transparent;
}
nav.scrolled { backdrop-filter:blur(24px);background:rgba(7,8,15,0.6);border-color:rgba(255,192,0,0.06); }
.nav-logo { display:flex;align-items:center;gap:.7rem; }
.hex { width:20px;height:20px;background:var(--gold);clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);flex-shrink:0; }
.logo-text { font-family:'Bebas Neue',cursive;font-size:1.4rem;letter-spacing:.3em;color:var(--white); }
.nav-right { display:flex;align-items:center;gap:2.5rem; }
.nav-link { font-size:.58rem;letter-spacing:.25em;text-transform:uppercase;color:var(--white-dim);text-decoration:none;transition:color .3s;cursor:none; }
.nav-link:hover { color:var(--gold); }
.nav-cta { font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;padding:.6rem 1.5rem;border:1px solid var(--gold);color:var(--gold);text-decoration:none;transition:all .3s;cursor:none; }
.nav-cta:hover { background:var(--gold);color:var(--darker); }

/* SECTIONS */
.sec {
  position:fixed;top:0;left:0;width:100%;height:100%;
  z-index:10;pointer-events:none;
  opacity:0;transition:opacity .7s;
  display:flex;align-items:center;justify-content:center;flex-direction:column;
}
.sec.active { opacity:1; }

/* HERO */
#s-hero { text-align:center; }
.hero-eyebrow { font-size:.58rem;letter-spacing:.5em;text-transform:uppercase;color:var(--gold);margin-bottom:2rem;opacity:0;animation:riseIn .9s .3s forwards; }
.hero-h1 { font-family:'Bebas Neue',cursive;font-size:clamp(5.5rem,15vw,14rem);line-height:.85;letter-spacing:-.02em;color:var(--white);opacity:0;animation:riseIn .9s .55s forwards; }
.hero-h1 .g { color:var(--gold);text-shadow:0 0 40px rgba(255,192,0,0.4); }
.hero-sub { font-family:'DM Serif Display',serif;font-style:italic;font-size:clamp(.9rem,2.2vw,1.5rem);color:var(--white-dim);margin-top:1.8rem;letter-spacing:.02em;opacity:0;animation:riseIn .9s .8s forwards; }
.hero-actions { display:flex;align-items:center;gap:2rem;margin-top:3rem;justify-content:center;opacity:0;animation:riseIn .9s 1.05s forwards;pointer-events:auto; }
.btn-primary { padding:1rem 3rem;background:var(--gold);color:var(--darker);font-family:'JetBrains Mono',monospace;font-size:.62rem;letter-spacing:.25em;text-transform:uppercase;text-decoration:none;cursor:none;transition:all .3s;position:relative;overflow:hidden; }
.btn-primary::after { content:'';position:absolute;inset:0;background:rgba(255,255,255,.15);transform:translateX(-100%);transition:transform .4s; }
.btn-primary:hover::after { transform:translateX(0); }
.btn-ghost { padding:1rem 3rem;border:1px solid rgba(255,192,0,.25);color:var(--white-dim);font-family:'JetBrains Mono',monospace;font-size:.62rem;letter-spacing:.25em;text-transform:uppercase;text-decoration:none;cursor:none;transition:all .3s; }
.btn-ghost:hover { border-color:var(--gold);color:var(--gold); }

/* SCROLL HINT */
#scroll-ind { position:fixed;bottom:2.5rem;left:50%;transform:translateX(-50%);z-index:400;text-align:center;pointer-events:none;opacity:0;animation:riseIn .9s 1.5s forwards; }
#scroll-ind span { font-size:.48rem;letter-spacing:.4em;text-transform:uppercase;color:rgba(245,240,232,.18); }
.scroll-line { width:1px;height:40px;background:linear-gradient(to bottom,var(--gold),transparent);margin:.5rem auto 0;animation:blinkLine 2s infinite; }
@keyframes blinkLine { 0%,100%{opacity:.2}50%{opacity:1} }

/* SCORE */
#s-score { flex-direction:column;text-align:center; }
.score-label { font-size:.55rem;letter-spacing:.45em;text-transform:uppercase;color:var(--gold);margin-bottom:2rem; }
.score-ring-wrap { position:relative;width:260px;height:260px;margin:0 auto; }
#score-svg { position:absolute;top:0;left:0;width:100%;height:100%;transform:rotate(-90deg); }
.score-bg-ring { fill:none;stroke:rgba(255,192,0,0.07);stroke-width:2; }
.score-fill-ring { fill:none;stroke:var(--gold);stroke-width:2;stroke-linecap:round;stroke-dasharray:720;stroke-dashoffset:720;transition:stroke-dashoffset 2.2s cubic-bezier(.4,0,.2,1);filter:drop-shadow(0 0 10px rgba(255,192,0,.7)); }
.score-outer-ring { fill:none;stroke:rgba(255,192,0,0.04);stroke-width:8; }
.score-number { position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Bebas Neue',cursive;font-size:5.5rem;color:var(--gold);line-height:1;text-shadow:0 0 30px rgba(255,192,0,.5); }
.score-sub { font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(245,240,232,.25);margin-top:.4rem; }
.score-verdict { font-family:'DM Serif Display',serif;font-style:italic;font-size:clamp(1.3rem,3.5vw,2.5rem);color:var(--white);margin-top:2rem;max-width:500px;text-align:center; }
.score-verdict em { color:var(--gold);font-style:normal; }

/* PROBLEMS */
#s-problems { align-items:flex-start;padding:0 8vw;justify-content:center; }
.problems-inner { width:100%;max-width:1100px;margin:0 auto; }
.sec-eyebrow { font-size:.52rem;letter-spacing:.45em;text-transform:uppercase;color:var(--gold);margin-bottom:2.5rem; }
.problems-h { font-family:'Bebas Neue',cursive;font-size:clamp(2.8rem,6.5vw,6rem);line-height:.93;margin-bottom:3rem;color:var(--white); }
.problems-h em { color:var(--gold);font-style:normal; }
.problem-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,192,0,0.06); }
.problem-card { background:rgba(7,8,15,0.8);padding:1.8rem 1.4rem;border-top:1px solid rgba(255,192,0,.1);backdrop-filter:blur(8px);transition:background .3s; }
.problem-card:hover { background:rgba(255,192,0,0.04); }
.problem-icon { font-size:1.3rem;margin-bottom:.8rem; }
.problem-title { font-family:'Bebas Neue',cursive;font-size:1.3rem;letter-spacing:.05em;color:var(--gold);margin-bottom:.5rem; }
.problem-desc { font-size:.55rem;letter-spacing:.07em;line-height:2;color:var(--white-dim); }
.problem-amount { font-family:'Bebas Neue',cursive;font-size:2.2rem;color:var(--white);margin-top:.7rem;text-shadow:0 0 20px rgba(255,192,0,.2); }

/* HOW */
#s-how { align-items:flex-start;padding:0 8vw;justify-content:center; }
.how-inner { width:100%;max-width:860px; }
.how-h { font-family:'Bebas Neue',cursive;font-size:clamp(2.8rem,6.5vw,6rem);line-height:.93;color:var(--white);margin-bottom:3.5rem; }
.how-h em { color:var(--gold);font-style:normal; }
.steps { display:flex;flex-direction:column; }
.step { display:grid;grid-template-columns:70px 1fr;gap:2rem;padding:1.8rem 0;border-bottom:1px solid rgba(255,192,0,0.07);align-items:start; }
.step-num { font-family:'Bebas Neue',cursive;font-size:3.5rem;color:rgba(255,192,0,.12);line-height:1; }
.step-title { font-family:'Bebas Neue',cursive;font-size:1.7rem;letter-spacing:.04em;color:var(--white);margin-bottom:.5rem; }
.step-title em { color:var(--gold);font-style:normal; }
.step-desc { font-size:.56rem;letter-spacing:.07em;line-height:2.2;color:var(--white-dim); }

/* WAITLIST */
#s-waitlist { flex-direction:column;text-align:center;padding:0 5vw; }
.waitlist-h { font-family:'Bebas Neue',cursive;font-size:clamp(3.5rem,10vw,9.5rem);line-height:.88;color:var(--white);margin-bottom:1.5rem; }
.waitlist-h em { color:var(--gold);text-shadow:0 0 50px rgba(255,192,0,.35);font-style:normal; }
.waitlist-sub { font-family:'DM Serif Display',serif;font-style:italic;font-size:clamp(.85rem,1.8vw,1.2rem);color:var(--white-dim);margin-bottom:3rem; }
.waitlist-form { display:flex;max-width:460px;margin:0 auto;pointer-events:auto; }
.waitlist-input { flex:1;padding:.9rem 1.4rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,192,0,.18);border-right:none;color:var(--white);font-family:'JetBrains Mono',monospace;font-size:.6rem;letter-spacing:.1em;outline:none;cursor:text;transition:border-color .3s; }
.waitlist-input::placeholder { color:rgba(245,240,232,.18); }
.waitlist-input:focus { border-color:rgba(255,192,0,.5); }
.waitlist-btn { padding:.9rem 1.8rem;background:var(--gold);color:var(--darker);font-family:'JetBrains Mono',monospace;font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;border:none;cursor:none;transition:all .3s;white-space:nowrap; }
.waitlist-btn:hover { background:var(--white); }
.waitlist-count { margin-top:1.8rem;font-size:.52rem;letter-spacing:.18em;color:rgba(245,240,232,.18);text-transform:uppercase; }
.waitlist-count span { color:var(--gold); }

/* FLOATING STATS */
.fstat { position:fixed;z-index:15;background:rgba(7,8,15,0.75);border:1px solid rgba(255,192,0,.1);backdrop-filter:blur(20px);padding:.9rem 1.2rem;pointer-events:none;opacity:0;transition:opacity .7s,transform .7s;transform:translateY(12px); }
.fstat.show { opacity:1;transform:translateY(0); }
.fstat-label { font-size:.47rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(245,240,232,.28); }
.fstat-val { font-family:'Bebas Neue',cursive;font-size:2rem;color:var(--gold);line-height:1.15;margin-top:.15rem; }
.fstat-delta { font-size:.45rem;letter-spacing:.1em;margin-top:.1rem; }
.up { color:#4ade80; } .dn { color:#f87171; }
#fs1{top:22%;left:4%;} #fs2{top:36%;right:4%;} #fs3{bottom:30%;left:6%;} #fs4{bottom:22%;right:5%;}

/* FOOTER */
footer { position:fixed;bottom:0;left:0;right:0;z-index:400;display:flex;justify-content:space-between;align-items:center;padding:1.1rem 3rem;pointer-events:none; }
.ft { font-size:.48rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(245,240,232,.12); }
.ft-gold { color:var(--gold); }

@keyframes riseIn { from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)} }

/* MOBILE */
@media(max-width:768px){
  nav{padding:1.2rem 1.5rem;}
  .nav-right .nav-link{display:none;}
  #s-problems,#s-how{padding:0 4vw;}
  .problem-grid{grid-template-columns:1fr;}
  footer{padding:.8rem 1.5rem;}
}
</style>
